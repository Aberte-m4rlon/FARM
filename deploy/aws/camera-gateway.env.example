# Current reported camera network: 10.20.6.237/19, gateway 10.20.10.1,
# DNS 121.54.70.150. This is an observed lease, not a confirmed reservation.
# Keep this placeholder until the lease is verified/reserved and the VPN route exists.
CAMERA_IP=REPLACE_WITH_FIXED_PRIVATE_CAMERA_IP
CAMERA_RTSP_PORT=554
CAMERA_STREAM_PATH=/stream1
CAMERA_USERNAME=REPLACE_WITH_CAMERA_ONLY_USERNAME
CAMERA_PASSWORD=REPLACE_WITH_CAMERA_ONLY_PASSWORD

# Private HTTPS API upload. Use the existing production gateway token.
ALPASFARM_API_URL=https://alpasfarm.site
CAMERA_GATEWAY_TOKEN=REPLACE_WITH_PRODUCTION_GATEWAY_TOKEN
CAMERA_GATEWAY_MAX_FPS=5
CAMERA_GATEWAY_MAX_WIDTH=960
CAMERA_GATEWAY_JPEG_QUALITY=72

# Begin at one CPU inference frame per second.
CAMERA_INFERENCE_FPS=1
CAMERA_MODEL_PATH=/var/lib/alpasfarm-camera-gateway/models/best.pt

GATE_LINE_Y=0.55
GATE_ENTRY_FLOW=top-to-bottom
