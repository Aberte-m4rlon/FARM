# Public website and Supabase anon key (these are public browser config values).
ALPAS_DOMAIN=alpasfarm.site
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Private server credentials. Create a new random value for ML_API_SECRET.
ML_API_SECRET=replace-with-a-long-random-secret
# Required for the always-on API worker to scan due pregnancies every minute.
# Keep this private; never put it in a VITE_ variable or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Private farm camera gateway. Keep the same random 64+ character token on the
# VPS and the farm PC's camera-gateway/.env. Set the owner's Supabase Auth UUID.
CAMERA_OWNER_USER_ID=
CAMERA_GATEWAY_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional primary provider for the camera health scan. If set, Gemini is used
# before Groq. Keep this server-side; never add it to a VITE_ variable.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash

# The new goat/sheep model will be installed here after training and review.
YOLO_MODEL_VERSION=new-model-pending
YOLO_SPECIES_MODEL_DIR=./ml-server/models/active
YOLO_SPECIES_MODEL_PATH=/models/active/best.pt

# Optional integrations used by existing API routes.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ALPASFARM
