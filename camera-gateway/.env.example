# Roboflow hosted animal detector. Any ROBOFLOW_* setting selects hybrid mode
# and fails closed if credentials or the SDK are unavailable.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=animal-detect-8sepq/2
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_CONFIDENCE_THRESHOLD=0.50
ROBOFLOW_REQUEST_TIMEOUT_SECONDS=8
CAMERA_ML_INTERVAL_SECONDS=1.0
CAMERA_ML_MAX_INTERVAL_SECONDS=2.5

# Optional private detector compatibility settings. Roboflow takes precedence
# whenever any ROBOFLOW_* setting is present.
CAMERA_HYBRID_DETECTOR_URL=
CAMERA_HYBRID_API_KEY=
CAMERA_HYBRID_MODEL_SHA256=
# Optional fixed-camera background ROIs, normalized as x1,y1,x2,y2; separate multiple with semicolons.
# Default Tapo C320WS upper-right beam false-positive area.
CAMERA_HYBRID_EXCLUDED_REGIONS=0.68,0.05,0.84,0.38
CAMERA_HYBRID_MAX_DETECTOR_GAP_SECONDS=8
CAMERA_HYBRID_SINGLE_HIT_CONFIDENCE=0.75
# Local-only test safeguard: requires a loopback ALPASFARM_API_URL. In this mode,
# gateway calls carry a test-only marker; API persistence, recording uploads, and
# service heartbeats are disabled while preview/counts stay in local memory.
CAMERA_HYBRID_TEST_ONLY=0
CAMERA_TEST_VIDEO_PATH=
CAMERA_TEST_VIDEO_START_SECONDS=0
CAMERA_TEST_VIDEO_DURATION_SECONDS=0
CAMERA_TEST_VIDEO_SPEED=1.0
