# Camera-only Tapo account. Do not reuse the Tapo app login.
# Set only after the router DHCP reservation is confirmed. The previously
# observed lease is not guaranteed to remain stable.
CAMERA_IP=REPLACE_WITH_FIXED_PRIVATE_CAMERA_IP
CAMERA_RTSP_PORT=554
CAMERA_STREAM_PATH=/stream1
CAMERA_USERNAME=
CAMERA_PASSWORD=

# Private HTTPS upload to ALPASFARM. Use the exact same random token as the VPS.
ALPASFARM_API_URL=https://alpasfarm.site
CAMERA_GATEWAY_TOKEN=
CAMERA_PREVIEW_UPLOAD_FPS=2
CAMERA_FRAME_UPLOAD_TIMEOUT=8
CAMERA_FRAME_MAX_RETRIES=2
CAMERA_FRAME_BACKOFF_INITIAL=2
CAMERA_FRAME_BACKOFF_MAX=30
CAMERA_GATEWAY_MAX_WIDTH=960
CAMERA_GATEWAY_JPEG_QUALITY=72

# RTSP reconnects stay on one stream with exponential delays. If stream1 fails,
# stream2 is used and stream1 is retried after the configured fallback interval.
RTSP_RECONNECT_DELAY=2
RTSP_RECONNECT_MAX_DELAY=30
RTSP_PRIMARY_RETRY_SECONDS=300
RTSP_READ_FAILURE_THRESHOLD=8

# Keep model weights private; default path is ../ml-server/models/active/best.pt.
CAMERA_INFERENCE_FPS=1
CAMERA_GATEWAY_DEBUG=0
CAMERA_MODEL_PATH=../ml-server/models/active/best.pt
CAMERA_FLOW_STATE_PATH=./state/camera-flow-counts.json

